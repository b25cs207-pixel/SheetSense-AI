# SheetSense AI Environment Configuration
# Copy this file to .env and replace the placeholder values.

# AI Provider ("gemini", "openai", or "fallback")
AI_PROVIDER=gemini

# Google Gemini API Key (Optional - Fallback deterministic engine runs if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
MAX_FILE_SIZE_MB=50
MAX_ROWS_LIMIT=100000
